# Optional external durable evidence root. Defaults to ./enza_memory.
ENZA_DATA_ROOT=

# Optional local Hugging Face model root. When set, model loading resolves
# model identifiers below this directory instead of using the default source.
ENZA_MODEL_ROOT=

# Set to 1/true/yes/on to force local-only Hugging Face model loading.
HF_HUB_OFFLINE=0
